# MMS Listener Configuration Template
# Copy this to application.yml and customize for your environment

spring:
  application:
    name: mms-listener

# MMS Backend Configuration
mms:
  backend:
    url: http://localhost:8080       # Change to your MMS backend URL
    username: your_username          # Your MMS username
    password: your_password          # Your MMS password
  
  # Folders to monitor (only used in listener mode)
  # Add all the folders you want to monitor for file changes
  folders:
    - "/path/to/your/images"         # Example: Image folder
    - "/path/to/your/documents"      # Example: Document folder
    - "/path/to/your/videos"         # Example: Video folder
    # Add more folders as needed
  
  # File patterns to include/exclude
  file-patterns:
    # Include pattern: files matching this regex will be processed
    include: "\\.(jpg|jpeg|png|gif|bmp|tiff|webp|svg|mp4|avi|mov|wmv|flv|mkv|webm|mp3|wav|flac|aac|ogg|pdf|doc|docx|xls|xlsx|ppt|pptx|txt|csv|zip|rar|tar|gz)$"
    # Exclude pattern: files matching this regex will be skipped
    exclude: "\\.(tmp|temp|log|bak|swp|~)$"
  
  # Backup configuration (only used in backup mode)
  backup:
    download-folder: "./backups"     # Local folder where backups will be saved
    max-concurrent-downloads: 5      # Number of concurrent downloads (adjust based on your system)

# Server configuration (for health checks)
server:
  port: 8081                        # Port for the application (different from backend)

# Logging configuration
logging:
  level:
    com.mms.listener: INFO          # Change to DEBUG for more detailed logs
    org.springframework.web.reactive: WARN

