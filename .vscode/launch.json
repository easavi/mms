{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "type": "java",
            "name": "MmsApplication",
            "request": "launch",
            "mainClass": "com.mms.MmsApplication",
            "projectName": "mms-backend"
        },
        {
            "name": "frontend",
            "cwd": "frontend",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "frontend (Chrome)",
            "cwd": "frontend",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome"
        },
        {
            "name": "frontend (Windows)",
            "cwd": "frontend",
            "request": "launch",
            "type": "dart",
            "deviceId": "windows"
        },
        {
            "name": "frontend (Chrome Profile)",
            "cwd": "frontend",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "flutterMode": "profile"
        },
        {
            "name": "frontend (profile mode)",
            "cwd": "frontend",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "frontend (release mode)",
            "cwd": "frontend",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "type": "java",
            "name": "MMS Listener - Listener Mode",
            "request": "launch",
            "mainClass": "com.mms.listener.MmsListenerApplication",
            "projectName": "mms-listener",
            "args": ["--mode=listener"],
            "cwd": "${workspaceFolder}/listener",
            "console": "integratedTerminal",
            "env": {},
            "vmArgs": [],
            "presentation": {
                "hidden": false,
                "group": "MMS Listener",
                "order": 1
            }
        },
        {
            "type": "java",
            "name": "MMS Listener - Debug (Listener)",
            "request": "launch",
            "mainClass": "com.mms.listener.MmsListenerApplication",
            "projectName": "mms-listener",
            "args": ["--mode=listener"],
            "cwd": "${workspaceFolder}/listener",
            "console": "integratedTerminal",
            "env": {
                "SPRING_PROFILES_ACTIVE": "debug"
            },
            "vmArgs": [
                "-Dlogging.level.com.mms.listener=DEBUG",
                "-Dlogging.level.org.springframework.web.reactive=DEBUG"
            ],
            "presentation": {
                "hidden": false,
                "group": "MMS Listener Debug",
                "order": 3
            }
        }
    ]
}